# URL API FastAPI, tanpa slash di akhir.
# Lokal:    http://localhost:8000
# Produksi: domain project backend Vercel, mis. https://avm-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Catatan: variabel backend di bawah ini TIDAK dipakai oleh frontend. Set nilainya
# di project Vercel backend (Root Directory = ./), bukan di project ini.
#   MODEL_PATH=models/model_pipeline_v1.joblib
#   META_PATH=models/model_meta_v1.json
#   ALLOWED_ORIGINS=https://<domain-frontend>.vercel.app
