# =============================================================================
# Backend API — project Vercel dengan Root Directory = ./
# =============================================================================
# Path artefak relatif terhadap root repo (boleh absolut). Default di
# api/main.py sudah menunjuk ke model v1; di Vercel tetap set eksplisit.
MODEL_PATH=models/model_pipeline_v1.joblib
META_PATH=models/model_meta_v1.json

# Origin frontend yang diizinkan, dipisah koma. Isi dengan domain produksi
# frontend setelah project frontend selesai di-deploy.
ALLOWED_ORIGINS=http://localhost:3000

# Opsional. Regex origin tambahan; default menangani semua preview *.vercel.app.
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

# =============================================================================
# Frontend — project Vercel dengan Root Directory = frontend/
# =============================================================================
# Diset di project frontend, BUKAN di project backend. Tanpa slash di akhir.
NEXT_PUBLIC_API_URL=http://localhost:8000
