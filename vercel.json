{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "pip install -r requirements.txt && pip uninstall -y shap numba llvmlite",
  "functions": {
    "api/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,notebooks/**,data/**,tests/**,reports/**,.github/**,requirements-dev.txt,Dockerfile,.dockerignore}"
    }
  }
}
